# 环境变量配置 (本地 dev / 评测环境共用)
# 评测环境用 source 加载即可。本地 dev 只用其中一部分。

# ---------------------------------------------------------------------------
# 评测环境（课程机）的默认值 —— source 后可直接跑 run_eval.sh
# ---------------------------------------------------------------------------
export AGENT_MODE=real

# 本地 Qwen2.5-VL 推理模型路径（评测环境用，本地 dev 可不设）
export QWEN_MODEL_PATH=/inspire/qb-ilm2/project/26summer-camp-16/public/Rag_Based_HistAgent/Models/qwen2.5-VL-7B-Instruct

# 本地 GME-Qwen2-VL embedding 模型路径（用于 DashVector 检索 query 向量）
# 评测环境必填；本地 dev 不设时，retriever 会尝试走 DashScope API（见下）
export GME_MODEL_PATH=/inspire/qb-ilm2/project/26summer-camp-16/public/Rag_Based_HistAgent/Models/gem-Qwen2-VL-7B-Instruct

# DashVector 向量库（生产 collection 用 GME-Qwen2-VL 编码，3584-dim 多向量）
export DASHVECTOR_ENDPOINT=vrs-cn-71j49hani00061.dashvector.cn-hangzhou.aliyuncs.com
export DASHVECTOR_API_KEY=sk-REPLACE-WITH-YOUR-OWN-VECTOR-KEY
export DASHVECTOR_COLLECTION=ccv_cb_student_20260508

# 多向量集合的查询向量字段（text / image / fused，默认 text）
export DASHVECTOR_VECTOR_FIELD=text

# 本地 dev 用 DashScope API 走 LLM 推理（评测环境留空，走 QWEN_MODEL_PATH）
# 注意：DashScope 不暴露 GME-Qwen2-VL embedding API，
# 所以本地 dev 走 API 时 retriever 会自动检测维度不匹配并降级为 NullRetriever。
# 若需要本地真检索，必须有 GME_MODEL_PATH。
# export QWEN_API_KEY=sk-xxxxxxxx
# export QWEN_MODEL_NAME=qwen2.5-vl-7b-instruct
# export QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DashScope embedding（API 模式 retriever 用，本地 dev 探索用；评测环境不用）
# export DASHSCOPE_API_KEY=$QWEN_API_KEY
# export DASHSCOPE_EMBED_MODEL=multimodal-embedding-v1   # 1024-dim，与生产集合不匹配，仅做调试

# ---------------------------------------------------------------------------
# 调试开关
# ---------------------------------------------------------------------------
# 强制跳过检索（最快闭卷推理）
# export DISABLE_RETRIEVAL=1

# scaffold 还接受 lowercase 别名
export vector_endpoint=$DASHVECTOR_ENDPOINT
export vector_api_key=$DASHVECTOR_API_KEY
